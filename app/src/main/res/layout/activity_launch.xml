<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_launch_splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:background="@drawable/bg_launch_orb_purple"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:alpha="0.95"
        android:translationX="-72dp"
        android:translationY="-36dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:background="@drawable/bg_launch_orb_cyan"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.85"
        android:translationX="48dp"
        android:translationY="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:text="CineFlow"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/text_high_emphasis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"/>

        <TextView
            android:text="Streaming tanpa batas"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_rounded"
        android:padding="22dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="38dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Memuat..."
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_high_emphasis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_launch_progress_value"
                android:text="0%"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_launch"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="18dp"
            android:max="100"
            android:progress="8"
            android:progressDrawable="@drawable/bg_launch_progress"
            style="?android:attr/progressBarStyleHorizontal"/>

        <TextView
            android:id="@+id/tv_launch_footer"
            android:text="Persiapan aplikasi..."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
